# Hearthfund settings. Copy to .env and edit; every line is optional.
# Docker Compose reads .env automatically. Never commit your .env.

# ---- Compose only (not read by the app)
# Image to run. The default is the newest release; pin one to upgrade only when you choose.
# Building from source (compose.build.yml) uses hearthfund:local.
#HBUDGET_IMAGE=ghcr.io/optimus506/hearthfund:latest
# Build from this folder instead of pulling (docs/DEPLOY.md, "Quick start"):
#COMPOSE_FILE=docker-compose.yml:compose.build.yml
# Port on this machine. If you change it, also set HBUDGET_PUBLIC_URL below.
#HBUDGET_HOST_PORT=8080
# Address on this machine the port is published on. 127.0.0.1 = this machine only (default).
# 0.0.0.0 = every network interface, so other devices on your home network can reach it over
# plain HTTP. Only on a trusted network, never forwarded on your router; then also set
# HBUDGET_ALLOWED_HOSTS and HBUDGET_PUBLIC_URL to this machine's LAN address (docs/DEPLOY.md).
#HBUDGET_BIND_ADDRESS=127.0.0.1
# A second deployment on the same machine: its own Compose project (see docs/DEPLOY.md).
#COMPOSE_PROJECT_NAME=hearthfund

# Folder on this machine mounted read-only at /certs in the container (for HTTPS, below).
#HBUDGET_CERTS_DIR=./certs

# ---- HTTPS with your own certificate (docs/DEPLOY.md)
# Paths inside the container. Set both, or neither (plain HTTP). PEM files: the certificate
# (with its chain) and an unencrypted private key readable by the app user (uid 10001).
#HBUDGET_TLS_CERT=/certs/fullchain.pem
#HBUDGET_TLS_KEY=/certs/privkey.pem

# ---- Network and browser checks
# Host names the app answers to (comma-separated). Add the name you use in the browser,
# e.g. budget.example.com or a Tailscale name, and keep 127.0.0.1 and localhost: the container's
# health check uses them. Anything else gets 400.
#HBUDGET_ALLOWED_HOSTS=127.0.0.1,localhost
# The address people type in the browser, if it is not http://127.0.0.1:8080
# (a reverse proxy, a Tailscale HTTPS name, or a different host port). Used for the CSRF origin check.
#HBUDGET_PUBLIC_URL=https://budget.example.com
# Secure cookies: auto (on for HTTPS requests), true (always; use with HTTPS), false (never).
#HBUDGET_COOKIE_SECURE=auto
# Only behind a reverse proxy: trust X-Forwarded-For/-Proto from these proxy addresses.
#HBUDGET_TRUST_PROXY=0
#HBUDGET_FORWARDED_ALLOW_IPS=127.0.0.1

# ---- Inside the container (the image sets these; change only if you know why)
#HBUDGET_DATA_DIR=/data
#HBUDGET_HOST=0.0.0.0
#HBUDGET_PORT=8080

# ---- Sessions, uploads, logging
# Signed-in sessions expire after this many idle hours (1-168). Absolute limit: 7 days.
#HBUDGET_SESSION_HOURS=12
# Largest upload in MB (1-50).
#HBUDGET_MAX_UPLOAD_MB=5
# debug, info, warning or error
#HBUDGET_LOG_LEVEL=info

# ---- Keys and first run
# Normally leave empty: a random key is created in the data folder (data/secret_key, mode 600).
#HBUDGET_SECRET_KEY=
# Create the first admin without the setup screen. Read only while no users exist.
# Remove both lines after the first start: environment values stay visible in `docker inspect`.
#HBUDGET_ADMIN_USERNAME=
#HBUDGET_ADMIN_PASSWORD=

# ---- Bank connection through Plaid (optional; docs/DEPLOY.md, docs/PLAID.md)
# off (default) = no outbound connections at all. sandbox = Plaid's test banks. production = real banks.
# A household owner must also turn it on in the app (More > Bank connection).
#HBUDGET_PLAID=off
#HBUDGET_PLAID_CLIENT_ID=
# The secret for that environment: in a file (kept out of `docker inspect`), or directly.
#HBUDGET_PLAID_SECRET_FILE=/data/plaid_secret
#HBUDGET_PLAID_SECRET=

# ---- Sign-in
# Two-factor sign-in (an authenticator app) is optional: each user turns it on under Account.
# 1 = every user must turn it on; until they do, they can only reach the page that sets it up.
# Lost phone: `docker compose exec app hbudget disable-2fa USERNAME`, or the admin resets it on the Admin page.
#HBUDGET_REQUIRE_2FA=0

# ---- Demo and development
# 1 = create a demo household with fake data on first run (the setup screen also offers this).
#HBUDGET_DEMO=0
# Development mode (detailed error pages). Refused unless the host is 127.0.0.1/localhost,
# so it cannot be used inside the container.
#HBUDGET_DEV=0

# ---- File ownership of ./data (Compose only)
# The app runs as uid/gid 10001 by default. To own the files yourself, set these to the output of `id -u` / `id -g`.
# 0 (root) is refused.
#HBUDGET_UID=10001
#HBUDGET_GID=10001
