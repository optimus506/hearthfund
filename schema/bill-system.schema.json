          "enum": [
            "income",
            "bill",
            "spending"
          ]
        },
        "amount": {
          "$ref": "#/$defs/signedMoney",
          "description": "Ledger sign: + out, - in."
        },
        "due": {
          "$ref": "#/$defs/date"
        },
        "order_date": {
          "$ref": "#/$defs/date"
        },
        "seq": {
          "type": "integer"
        },
        "state": {
          "enum": [
            "open",
            "cleared",
            "removed"
          ]
        },
        "status": {
          "oneOf": [
            {
              "$ref": "#/$defs/status"
            },
            {
              "type": "null"
            }
          ],
          "description": "Per-row override; null = the series default."
        },
        "amount_was": {
          "oneOf": [
            {
              "$ref": "#/$defs/signedMoney"
            },
            {
              "type": "null"
            }
          ]
        },
        "overridden": {
          "type": "boolean"
        },
        "cleared_txn": {
          "oneOf": [
            {
              "$ref": "#/$defs/rowId"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleared_on": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "card": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Card-funded by this credit-card account."
        },
        "paid": {
          "$ref": "#/$defs/money",
          "description": "Partial payments already taken off amount (reduce)."
        },
        "paid_txns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rowId"
          }
        },
        "paid_at_change": {
          "$ref": "#/$defs/money"
        },
        "nominal": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Occurrence date before the weekend shift (series rows); with series it identifies the occurrence."
        }
      }
