        },
        "target": {
          "$ref": "#/$defs/money"
        },
        "months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "saved": {
          "$ref": "#/$defs/money"
        },
        "by": {
          "$ref": "#/$defs/date"
        },
        "start_debt": {
          "$ref": "#/$defs/money"
        }
      }
